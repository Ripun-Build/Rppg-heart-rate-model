{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Phase 1: check dataset",
            "type": "debugpy",
            "request": "launch",
            "module": "src.check_dataset",
            "args": [
                "--subject",
                "${input:subject}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 2: preprocess videos",
            "module": "src.preprocess",
            "args": [
                "--workers",
                "6"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 2: check preprocessing",
            "module": "src.check_preprocess",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: overfit sanity test",
            "module": "src.train",
            "args": [
                "--overfit",
                "4"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: train PhysNet",
            "module": "src.train",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: resume training",
            "module": "src.train",
            "args": [
                "--resume"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: train PhysNet (regularized, run 2)",
            "module": "src.train",
            "args": [
                "--config",
                "configs/physnet_ubfc_reg.yaml"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: resume regularized training",
            "module": "src.train",
            "args": [
                "--config",
                "configs/physnet_ubfc_reg.yaml",
                "--resume"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: train PhysNet (balanced + EMA, run 3)",
            "module": "src.train",
            "args": [
                "--config",
                "configs/physnet_ubfc_ema.yaml"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 3: resume run 3",
            "module": "src.train",
            "args": [
                "--config",
                "configs/physnet_ubfc_ema.yaml",
                "--resume"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 5: evaluate main model",
            "module": "src.evaluate",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Phase 5: evaluate + ablation (runs 2, 3)",
            "module": "src.evaluate",
            "args": [
                "--ablation"
            ],
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Model smoke test",
            "type": "debugpy",
            "request": "launch",
            "module": "src.model",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "subject",
            "type": "promptString",
            "description": "Subject number for the detailed plot (e.g. 1, 14, 24)",
            "default": "1"
        }
    ]
}