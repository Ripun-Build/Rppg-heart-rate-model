.venv/
__pycache__/
*.pyc
.DS_Store

# Datasets and outputs are large / licensed - never commit them
data/raw/*
data/processed/*
!data/**/.gitkeep
# Trained weights are ignored, except the main model so the webcam app runs right after cloning
checkpoints/*
!checkpoints/physnet_ubfc/
checkpoints/physnet_ubfc/*
!checkpoints/physnet_ubfc/best.pt
runs/
*.onnx

# Downloaded model weights (see README for the download command)
models/*.tflite

# Images that show dataset subjects' faces - UBFC license, never publish
outputs/**/private/

# Personal webcam heart-rate measurements (health data) - kept local
outputs/phase6/sessions_webcam.csv
